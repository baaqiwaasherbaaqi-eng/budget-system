-- ============================================
-- Seed: ساختار سازمانی
-- ============================================

-- حذف ایندکس یکتا (موقت)
DROP INDEX IF EXISTS idx_base_data_unique_code;

-- حذف داده‌های قبلی
DELETE FROM base_data WHERE section = 'organization' AND code = 'س-001';

-- درج
INSERT INTO base_data (section, type, prefix, code, digit_count, level, level_name, title, parent_id, sort_order, created_at_shamsi)
VALUES ('organization', 'general', 'س', 'س-001', 3, 0, 'حوزه', 'حوزه شهردار', NULL, 1, '1405/06/31');

-- بازسازی ایندکس یکتا
CREATE UNIQUE INDEX IF NOT EXISTS idx_base_data_unique_code 
ON base_data(section, COALESCE(fiscal_year_id, 0), COALESCE(type, ''), code);